{
  "name": "la-foi-video-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Studio de montage publicitaire local : timeline pilotée par configuration, rendu image par image (Chromium) et encodage FFmpeg.",
  "scripts": {
    "prepare-media": "node scripts/prepare-media.mjs",
    "align": "node scripts/align.mjs --silences",
    "build": "node scripts/build-timeline.mjs",
    "studio": "node scripts/studio.mjs",
    "preview": "node scripts/render.mjs --preview",
    "render": "node scripts/render.mjs",
    "render:square": "node scripts/render.mjs --format 1x1",
    "render:wide": "node scripts/render.mjs --format 16x9",
    "sheet": "node scripts/contact-sheet.mjs",
    "thumbnail": "node scripts/thumbnail.mjs",
    "qc": "node scripts/qc.mjs",
    "music": "node scripts/make-music.mjs",
    "voice": "node scripts/generate-voice.mjs"
  },
  "devDependencies": { "playwright": "^1.56.1" },
  "engines": { "node": ">=20" }
}
