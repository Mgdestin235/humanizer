  "units": [
    {
      "id": "u01",
      "text": "Le 20 octobre 2026, le Cabinet Médical LA FOI célèbre son anniversaire !",
      "start": 0.6,
      "end": 5.31
    },
    {
      "id": "u02",
      "text": "À cette occasion, nous renouvelons notre engagement :",
      "start": 5.76,
      "end": 8.5
    },
    {
      "id": "u03",
      "text": "rendre les soins médicaux plus accessibles à chaque famille.",
      "start": 8.95,
      "end": 12.48
    },
    {
      "id": "u04",
      "text": "Pour célébrer cet événement, nous lançons une campagne spéciale de consultations médicales gratuites, selon les conditions d'adhésion du cabinet.",
      "start": 12.93,
      "end": 20.38
    },
    {
      "id": "u05",
      "text": "Pour en profiter, procurez-vous votre carte d'adhésion, votre carnet médical personnel et votre fiche de bilan médical.",
      "start": 20.83,
      "end": 27.5
    },
    {
      "id": "u06",
      "text": "Ces trois documents vous permettent d'intégrer notre programme de suivi médical et de bénéficier d'avantages réservés aux adhérents.",
      "start": 27.95,
      "end": 35.01
    },
    {
      "id": "u07",
      "text": "Au-delà de cette campagne, votre adhésion vous permettra également de profiter de réductions sur certaines prestations éligibles, de facilités de suivi médical et de futurs programmes promotionnels.",
      "start": 35.46,
      "end": 46.05
    },
    {
      "id": "u08",
      "text": "Notre ambition est simple : vous accompagner dans la durée, vous encourager à consulter à temps et faire de la prévention une priorité.",
      "start": 46.5,
      "end": 55.12
    },
    {
      "id": "u09",
      "text": "Parce qu'au Cabinet Médical LA FOI, chaque patient mérite écoute, attention et dignité.",
      "start": 55.57,
      "end": 60.67
    },
    {
      "id": "u10",
      "text": "Rendez-vous dès le 20 octobre 2026 pour le lancement de notre campagne.",
      "start": 61.12,
      "end": 65.83
    },
    {
      "id": "u11",
      "text": "Prenez rendez-vous dès maintenant sur notre plateforme en ligne.",
      "start": 66.28,
      "end": 69.81
    },
    {
      "id": "u12",
      "text": "Cabinet Médical LA FOI. Votre santé, notre priorité. Votre confiance, notre engagement.",
      "start": 70.26,
      "end": 74.96
    },
    {
      "id": "u13",
      "text": "Ensemble, construisons une communauté en meilleure santé !",
      "start": 75.41,
      "end": 78.16
    }
  ]
